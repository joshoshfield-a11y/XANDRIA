{
  "name": "xandria-studio",
  "version": "1.0.0",
  "description": "XANDRIA Studio — deterministic intent-to-game engine. Type a prompt, get a playable PS2-era 3D game.",
  "author": "joshoshfield-a11y",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode player && vite build --mode studio",
    "build:player": "vite build --mode player",
    "export": "tsx scripts/export.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cli": "tsx scripts/export.ts",
    "studio": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^20.0.0",
    "@types/three": "^0.182.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.2.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.xandria.studio",
    "productName": "Xandria Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  }
}
